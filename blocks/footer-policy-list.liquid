
{% if shop.policies.size > 0 or shop.enabled_payment_types.size > 0 %}
  <nav
    class="footer-policy-list"
    aria-label="{{ 'content.terms_and_policies' | t | escape }}"
    style="
      {% render 'typography-style', preset: 'custom', settings: block.settings %}
      {% if block.settings.text_color != blank %}--color-utilities: {{ block.settings.text_color }};{% endif %}
    "
    {{ block.shopify_attributes }}
  >
    {%- if shop.policies.size > 0 -%}
      <ul
        class="
          policy_list list-unstyled
          custom-typography
          {% if block.settings.font_size != "" %}custom-font-size{% endif %}
        "
      >
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}
            <li>
              <a
                href="{{ policy.url }}"
                class="footer-utilities__text"
              >
                {{- policy.title | escape -}}
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if shop.enabled_payment_types.size > 0 -%}
      <div class="footer-policy-list__payments" aria-label="{{ 'blocks.payment_methods' | t | escape }}">
        <ul class="footer-policy-list__payment-icons list-unstyled" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li class="footer-policy-list__payment-icon">
              {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </nav>
{% endif %}

{% stylesheet %}
  .footer-policy-list {
    display: grid;
    justify-items: center;
    gap: 10px;
  }

  .policy_list {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin: 0;
    padding: 0;
  }

  .policy_list a {
    color: var(--color-utilities, var(--color-foreground-muted));
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    text-decoration: none;
    font-size: var(--font-size, 0.75rem);
    text-transform: var(--text-transform, none);
  }

  .policy_list a:hover {
    color: var(--color-foreground);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .footer-policy-list__payment-icons {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
  }

  .footer-policy-list__payment-icon {
    display: flex;
    align-items: center;
  }

  @media screen and (max-width: 749px) {
    .footer-policy-list {
      justify-items: center;
    }

    .policy_list {
      gap: 6px 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.policy_list",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.manage_policies"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "t:settings.size",
      "options": [
        {
          "value": "0.625rem",
          "label": "10px"
        },
        {
          "value": "0.75rem",
          "label": "12px"
        },
        {
          "value": "0.875rem",
          "label": "14px"
        },
        {
          "value": "1rem",
          "label": "16px"
        },
        {
          "value": "1.125rem",
          "label": "18px"
        }
      ],
      "default": "0.75rem"
    },
    {
      "type": "select",
      "id": "case",
      "label": "t:settings.case",
      "options": [
        {
          "value": "none",
          "label": "t:options.default"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "t:names.policy_list",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
